# Copiar a .env y completar. Nunca subir el .env al repositorio.

# ---------------------------------------------------------------- Obligatorias
# Secreto de la app de Meta (developers.facebook.com > tu app > Configuración > Básica). Se usa para
# verificar la firma X-Hub-Signature-256 de cada aviso del webhook.
META_APP_SECRET=
# Texto que inventás vos y pegás también en Meta al configurar el webhook (hub.verify_token).
META_VERIFY_TOKEN=
# Clave para entrar a la bandeja web (usar 12 caracteres o más).
BANDEJA_CLAVE=

# ---------------------------------------------------------------- Graph API
META_GRAPH_URL=https://graph.facebook.com
# Verificar la versión vigente en la documentación de Meta antes de desplegar.
META_API_VERSION=v21.0

# ---------------------------------------------------------------- Facebook Messenger
FB_PAGE_ID=
# Token de acceso de la PÁGINA (de larga duración o de usuario del sistema), no el de tu usuario.
FB_PAGE_TOKEN=

# ---------------------------------------------------------------- Instagram Direct
# Cuenta profesional de Instagram conectada a la página.
IG_ACCOUNT_ID=
# Si se deja vacío se usa FB_PAGE_TOKEN (caso "Instagram con inicio de sesión de Facebook").
IG_TOKEN=
# Solo si se usa "Instagram con inicio de sesión de Instagram": https://graph.instagram.com
IG_GRAPH_URL=

# ---------------------------------------------------------------- WhatsApp Cloud API
WA_PHONE_NUMBER_ID=
# Token permanente de un usuario del sistema con whatsapp_business_messaging.
WA_TOKEN=

# ---------------------------------------------------------------- Bandeja
# Agentes que se pueden asignar (separados por coma). Vacío = cualquier nombre.
AGENTES=Ana,Bruno
# Horas de la ventana de atención de Meta. No cambiar salvo que Meta cambie la regla.
VENTANA_HORAS=24
# Leer el nombre del cliente de Messenger/Instagram desde la Graph API.
CONSULTAR_PERFILES=si
DB_PATH=datos/bandeja.db
REGLAS_PATH=reglas.json

# ---------------------------------------------------------------- Avisos al equipo (opcionales)
# Webhook propio: recibe un POST JSON por cada conversación nueva o reabierta.
AVISO_WEBHOOK_URL=
# Telegram: token de @BotFather y chat (o grupo) donde avisar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_URL=https://api.telegram.org
# si = avisar cada mensaje, no solo conversaciones nuevas o reabiertas
AVISAR_CADA_MENSAJE=no
# URL pública de la bandeja, para poner un enlace directo en el aviso
BANDEJA_URL_PUBLICA=

# ---------------------------------------------------------------- Servidor
HOST=127.0.0.1
PUERTO=8000
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Demo (opcional)
DEMO_PUERTO_BANDEJA=8000
DEMO_PUERTO_SIMULADOR=8001
